    "md": { "$type": "shadow", "$value": { "color": "#1118271F", "offsetX": "0", "offsetY": "4px", "blur": "12px", "spread": "-2px" } },
    "lg": { "$type": "shadow", "$value": { "color": "#11182729", "offsetX": "0", "offsetY": "12px", "blur": "28px", "spread": "-6px" } }
