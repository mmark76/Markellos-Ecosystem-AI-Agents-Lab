{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security.ecosystem.invalid/schemas/security-exception.schema.json",
  "title": "Shield security exception",
  "description": "A visible, time-bounded deviation from a security control. Permanent or implicit bypasses are invalid.",
  "type": "object",
  "additionalProperties": false,
  "required": ["exceptionId", "affectedControlId", "rationale", "requester", "approver", "riskId", "compensatingControls", "scope", "startDate", "expiryDate", "reviewDate", "status"],
  "properties": {
    "exceptionId": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$" },
    "affectedControlId": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string", "minLength": 1 },
    "requester": { "type": "string", "minLength": 1 },
    "approver": { "type": "string", "minLength": 1, "description": "Named human approval authority." },
    "riskId": { "type": "string", "minLength": 1 },
    "compensatingControls": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "scope": { "type": "string", "minLength": 1 },
    "startDate": { "type": "string", "format": "date" },
    "expiryDate": { "type": "string", "format": "date" },
    "reviewDate": { "type": "string", "format": "date" },
    "status": { "enum": ["REQUESTED", "APPROVED", "REJECTED", "ACTIVE", "EXPIRED", "REVOKED", "CLOSED"] },
    "evidenceItemIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
