{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security.ecosystem.invalid/schemas/security-capability.schema.json",
  "title": "Shield security capability registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "mission", "currentState", "authority", "productionAuthorization", "statusModel", "actionabilityModel", "assessmentStates", "integrationBoundaries", "groups", "roadmapPhases", "capabilities"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "title": { "type": "string", "minLength": 1 },
    "mission": { "type": "string", "minLength": 1 },
    "currentState": { "type": "string", "minLength": 1 },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owns", "doesNotOwn"],
      "properties": {
        "owns": { "$ref": "#/$defs/nonEmptyStrings" },
        "doesNotOwn": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "productionAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant", "rule", "prohibitedInference"],
      "properties": {
        "invariant": { "const": "technical validation != authorization" },
        "rule": { "type": "string", "minLength": 1 },
        "prohibitedInference": { "type": "string", "minLength": 1 }
      }
    },
    "statusModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["PLANNED", "FOUNDATION", "PARTIAL", "IMPLEMENTED", "VERIFIED"],
      "properties": {
        "PLANNED": { "type": "string" },
        "FOUNDATION": { "type": "string" },
        "PARTIAL": { "type": "string" },
        "IMPLEMENTED": { "type": "string" },
        "VERIFIED": { "type": "string" }
      }
    },
    "actionabilityModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ROADMAP", "GOVERNANCE", "AVAILABLE"],
      "properties": {
        "ROADMAP": { "type": "string" },
        "GOVERNANCE": { "type": "string" },
        "AVAILABLE": { "type": "string" }
      }
    },
    "assessmentStates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["PASS", "FAIL", "BLOCKED", "NOT_TESTED", "TECHNICALLY_UNAVAILABLE"],
      "properties": {
        "PASS": { "type": "string" },
        "FAIL": { "type": "string" },
        "BLOCKED": { "type": "string" },
        "NOT_TESTED": { "type": "string" },
        "TECHNICALLY_UNAVAILABLE": { "type": "string" }
      }
    },
    "integrationBoundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "provides", "shieldRelationship"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "provides": { "type": "string", "minLength": 1 },
          "shieldRelationship": { "type": "string", "minLength": 1 }
        }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "purpose"],
        "properties": {
          "id": { "enum": ["GOVERN", "IDENTIFY", "PROTECT", "DETECT", "RESPOND", "RECOVER_ASSURE"] },
          "name": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 }
        }
      }
    },
    "roadmapPhases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "outcomes"],
        "properties": {
          "id": { "type": "integer", "minimum": 1, "maximum": 6 },
          "name": { "type": "string", "minLength": 1 },
          "outcomes": { "$ref": "#/$defs/nonEmptyStrings" }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capability" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "group", "purpose", "scope", "status", "actionability", "owner", "subCapabilities", "expectedPolicies", "expectedStandards", "expectedControls", "expectedEvidence", "dependencies", "roadmapPhase", "futureAutomation", "links"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "group": { "enum": ["GOVERN", "IDENTIFY", "PROTECT", "DETECT", "RESPOND", "RECOVER_ASSURE"] },
        "purpose": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PLANNED", "FOUNDATION", "PARTIAL", "IMPLEMENTED", "VERIFIED"] },
        "actionability": { "enum": ["ROADMAP", "GOVERNANCE", "AVAILABLE"] },
        "owner": { "type": "string", "minLength": 1 },
        "subCapabilities": { "$ref": "#/$defs/nonEmptyStrings" },
        "expectedPolicies": { "$ref": "#/$defs/nonEmptyStrings" },
        "expectedStandards": { "$ref": "#/$defs/nonEmptyStrings" },
        "expectedControls": { "$ref": "#/$defs/nonEmptyStrings" },
        "expectedEvidence": { "$ref": "#/$defs/nonEmptyStrings" },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "roadmapPhase": { "type": "integer", "minimum": 1, "maximum": 6 },
        "futureAutomation": { "$ref": "#/$defs/nonEmptyStrings" },
        "links": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    }
  }
}
